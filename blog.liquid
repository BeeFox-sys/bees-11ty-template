{% layout "body.liquid", title: "Blog" %}
{% block content %}
<h1> Blog </h1>
<ul class="post-list">
    {%- for post in collections.blog reversed -%}
    <li 
        {% if post.data.icon %} style="list-style-type: '{{post.data.icon}}';"{% endif %}
    ><a href="{{ post.url }}">
        {{post.data.date | date: "%Y-%m-%d"}} 
        · {{post.data.title}}</a> 
        <span class="post-preview">| {{post.content | strip_html | truncatewords: 8 }}
        </span>
    </li>
    {%- endfor -%}
</ul>
{% endblock %}